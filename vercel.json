{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/build-web.sh",
  "outputDirectory": "build/web",
  "functions": {"api/store.mjs": {"maxDuration": 30}},
  "rewrites": [{"source":"/((?!api/|assets/|canvaskit/|icons/|splash/|.*\\.).*)","destination":"/index.html"}],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]},
    {"source":"/(index.html|flutter_bootstrap.js|flutter_service_worker.js)","headers":[{"key":"Cache-Control","value":"no-cache"}]}
  ]
}
