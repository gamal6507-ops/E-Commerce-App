rules_version = '2';
// users: private profile (id, username, email, providerId, createdAt, photoUrl).
// cart/favorites: owner snapshots, never authoritative for prices or stock.
// locations: full delivery address. devices: owned notification tokens.
// products and orders: server-owned. paymentCards: no client access.
// accountDeletions: server-only tombstones prevent account recreation races.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function active(uid) {
      return signedIn() && request.auth.uid == uid &&
        !exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }
    function owner(uid) {
      return active(uid) && exists(/databases/$(database)/documents/users/$(uid));
    }
    function admin() { return signedIn() && request.auth.token.get('admin',false) == true; }
    function text(value,min,max) { return value is string && value.size() >= min && value.size() <= max; }
    function profile(data,uid) {
      return data.keys().hasAll(['id','username','email','createdAt','providerId','photoUrl']) &&
        data.keys().hasOnly(['id','username','email','createdAt','providerId','photoUrl']) &&
        data.id == uid && text(data.username,1,100) &&
        text(data.email,0,254) && data.email == request.auth.token.get('email','') &&
        text(data.createdAt,1,64) && text(data.providerId,1,64) &&
        text(data.photoUrl,0,150000) &&
        (data.photoUrl == '' || data.photoUrl.matches('^https://.*') ||
         data.photoUrl.matches('^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]+$'));
    }
    function product(data) {
      return data is map && data.keys().hasAll(['id','name','imgUrl','description','price','category','averageRate','requiresSize','stock']) &&
        data.keys().hasOnly(['id','name','imgUrl','description','price','category','averageRate','requiresSize','stock']) &&
        text(data.id,1,128) && text(data.name,1,200) && text(data.description,0,5000) &&
        text(data.imgUrl,0,2048) && (data.imgUrl == '' || data.imgUrl.matches('^https://.*')) &&
        text(data.category,0,100) && data.price is number && data.price >= 0 && data.price <= 1000000 &&
        data.averageRate is number && data.averageRate >= 0 && data.averageRate <= 5 &&
        data.requiresSize is bool && data.stock is int && data.stock >= 0 && data.stock <= 1000000;
    }
    function cart(data,id) {
      return data.keys().hasAll(['id','product','size','quantity']) && data.keys().hasOnly(['id','product','size','quantity']) &&
        data.id == id && text(data.id,1,128) && product(data.product) &&
        data.size in ['none','S','M','L','XL'] && data.quantity is int && data.quantity >= 1 && data.quantity <= 100;
    }
    function address(data,id) {
      return data.keys().hasAll(['id','city','country','imgUrl','isChosen','recipient','phone','street','building','unit','postalCode']) &&
        data.keys().hasOnly(['id','city','country','imgUrl','isChosen','recipient','phone','street','building','unit','postalCode']) &&
        data.id == id && text(data.id,1,128) && text(data.city,1,150) && text(data.country,1,150) &&
        text(data.recipient,1,150) && text(data.phone,7,25) && data.phone.matches('^[+0-9 ()-]+$') &&
        text(data.street,1,150) && text(data.building,1,150) && text(data.unit,0,150) && text(data.postalCode,0,150) &&
        text(data.imgUrl,0,2048) && data.isChosen is bool;
    }
    match /users/{uid} {
      allow get: if active(uid);
      allow create: if active(uid) && profile(request.resource.data,uid);
      allow update: if owner(uid) && profile(request.resource.data,uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id','createdAt','providerId']);
      allow delete,list: if false;
      match /cart/{id} {
        allow read,delete: if owner(uid);
        allow create,update: if owner(uid) && cart(request.resource.data,id);
      }
      match /favorites/{id} {
        allow read,delete: if owner(uid);
        allow create,update: if owner(uid) && product(request.resource.data) && request.resource.data.id == id;
      }
      match /locations/{id} {
        allow read,delete: if owner(uid);
        allow create,update: if owner(uid) && address(request.resource.data,id);
      }
      match /devices/{id} {
        allow read,delete: if owner(uid);
        allow create,update: if owner(uid) && request.resource.data.keys().hasAll(['token','updatedAt']) &&
          request.resource.data.keys().hasOnly(['token','updatedAt']) && text(request.resource.data.token,1,4096) &&
          request.resource.data.updatedAt == request.time;
      }
      match /orders/{id} {
        allow read: if owner(uid);
        allow write: if false;
      }
      match /notifications/{id} {
        allow read,delete: if owner(uid);
        allow update: if owner(uid) && request.resource.data.isRead is bool &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow create: if false;
      }
      match /paymentCards/{id} { allow read,write: if false; }
    }
    match /products/{id} {
      allow read: if resource.data.active == true || admin();
      allow write: if false;
    }
    match /{document=**} { allow read,write: if false; }
  }
}
